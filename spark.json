{
  "ssf": { "prefix": "ssf", "description": "SELECT * FROM", "body": ["SELECT *", "FROM $0"] },
  "sf": { "prefix": "sf", "description": "SELECT columns FROM", "body": ["SELECT $1", "FROM $0"] },
  "st10": { "prefix": "st10", "description": "SELECT * ... LIMIT 10", "body": ["SELECT *", "FROM $1", "LIMIT 10"] },
  "st100": { "prefix": "st100", "description": "SELECT * ... LIMIT 100", "body": ["SELECT *", "FROM $1", "LIMIT 100"] },
  "st1000": { "prefix": "st1000", "description": "SELECT * ... LIMIT 1000", "body": ["SELECT *", "FROM $1", "LIMIT 1000"] },
  "sd": { "prefix": "sd", "description": "SELECT DISTINCT ... FROM", "body": ["SELECT DISTINCT $1", "FROM $0"] },
  "scf": { "prefix": "scf", "description": "SELECT COUNT(*) FROM", "body": ["SELECT COUNT(*)", "FROM $0"] },
  "sw": { "prefix": "sw", "description": "SELECT * FROM ... WHERE", "body": ["SELECT *", "FROM $1", "WHERE $0"] },
  "sso": { "prefix": "sso", "description": "SELECT * FROM ... ORDER BY", "body": ["SELECT *", "FROM $1", "ORDER BY $0"] },
  "scg": { "prefix": "scg", "description": "Count rows per group", "body": ["SELECT $1, COUNT(*) AS cnt", "FROM $2", "GROUP BY $1", "ORDER BY cnt DESC"] },
  "dupes": { "prefix": "dupes", "description": "Find duplicate values", "body": ["SELECT $1, COUNT(*) AS cnt", "FROM $2", "GROUP BY $1", "HAVING COUNT(*) > 1", "ORDER BY cnt DESC"] },
  "lm": { "prefix": "lm", "description": "LIMIT 100", "body": "LIMIT 100$0" },

  "w2": { "prefix": "w2", "description": "WHERE", "body": "WHERE $0" },
  "wi": { "prefix": "wi", "description": "WHERE ... IN (...)", "body": "WHERE $1 IN ($0)" },
  "wlk": { "prefix": "wlk", "description": "WHERE ... LIKE '%...%'", "body": "WHERE $1 LIKE '%$0%'" },
  "wb": { "prefix": "wb", "description": "WHERE ... BETWEEN ... AND ...", "body": "WHERE $1 BETWEEN $2 AND $0" },
  "wn": { "prefix": "wn", "description": "WHERE ... IS NULL", "body": "WHERE $1 IS NULL$0" },
  "wnn": { "prefix": "wnn", "description": "WHERE ... IS NOT NULL", "body": "WHERE $1 IS NOT NULL$0" },

  "jn": { "prefix": "jn", "description": "JOIN ... ON", "body": "JOIN $1 ON $0" },
  "ij": { "prefix": "ij", "description": "INNER JOIN ... ON", "body": "INNER JOIN $1 ON $0" },
  "lj": { "prefix": "lj", "description": "LEFT JOIN ... ON", "body": "LEFT JOIN $1 ON $0" },
  "rj": { "prefix": "rj", "description": "RIGHT JOIN ... ON", "body": "RIGHT JOIN $1 ON $0" },
  "fj": { "prefix": "fj", "description": "FULL OUTER JOIN ... ON", "body": "FULL OUTER JOIN $1 ON $0" },
  "cj": { "prefix": "cj", "description": "CROSS JOIN", "body": "CROSS JOIN $0" },
  "lsj": { "prefix": "lsj", "description": "LEFT SEMI JOIN (rows that have a match)", "body": "LEFT SEMI JOIN $1 ON $0" },
  "laj": { "prefix": "laj", "description": "LEFT ANTI JOIN (rows with no match)", "body": "LEFT ANTI JOIN $1 ON $0" },
  "un": { "prefix": "un", "description": "UNION", "body": ["UNION", "$0"] },
  "ua": { "prefix": "ua", "description": "UNION ALL", "body": ["UNION ALL", "$0"] },

  "ob": { "prefix": "ob", "description": "ORDER BY", "body": "ORDER BY $0" },
  "obd": { "prefix": "obd", "description": "ORDER BY ... DESC", "body": "ORDER BY $1 DESC$0" },
  "gb": { "prefix": "gb", "description": "GROUP BY", "body": "GROUP BY $0" },
  "hv": { "prefix": "hv", "description": "HAVING", "body": "HAVING $0" },

  "ii": { "prefix": "ii", "description": "INSERT INTO ... VALUES", "body": ["INSERT INTO $1", "VALUES ($0)"] },
  "is": { "prefix": "is", "description": "INSERT INTO ... SELECT", "body": ["INSERT INTO $1", "SELECT *", "FROM $0"] },
  "io": { "prefix": "io", "description": "INSERT OVERWRITE ... SELECT", "body": ["INSERT OVERWRITE $1", "SELECT *", "FROM $0"] },
  "up": { "prefix": "up", "description": "UPDATE ... SET ... WHERE", "body": ["UPDATE $1", "SET $2", "WHERE $0"] },
  "dfw": { "prefix": "dfw", "description": "DELETE FROM ... WHERE", "body": ["DELETE FROM $1", "WHERE $0"] },
  "mrg": { "prefix": "mrg", "description": "MERGE INTO (Delta upsert)", "body": ["MERGE INTO $1 AS t", "USING $2 AS s", "\tON $3", "WHEN MATCHED THEN UPDATE SET *", "WHEN NOT MATCHED THEN INSERT *$0"] },

  "ct": { "prefix": "ct", "description": "CREATE TABLE ... USING DELTA", "body": ["CREATE TABLE $1 (", "\t$0", ") USING DELTA"] },
  "ctas": { "prefix": "ctas", "description": "CREATE OR REPLACE TABLE ... AS SELECT", "body": ["CREATE OR REPLACE TABLE $1 AS", "SELECT *", "FROM $0"] },
  "cv": { "prefix": "cv", "description": "CREATE OR REPLACE VIEW", "body": ["CREATE OR REPLACE VIEW $1 AS", "SELECT *", "FROM $0"] },
  "ctv": { "prefix": "ctv", "description": "CREATE OR REPLACE TEMP VIEW", "body": ["CREATE OR REPLACE TEMP VIEW $1 AS", "SELECT *", "FROM $0"] },
  "dt": { "prefix": "dt", "description": "DROP TABLE IF EXISTS", "body": "DROP TABLE IF EXISTS $0" },
  "dsc": { "prefix": "dsc", "description": "DESCRIBE TABLE EXTENDED", "body": "DESCRIBE TABLE EXTENDED $0" },
  "dh": { "prefix": "dh", "description": "DESCRIBE HISTORY (Delta versions)", "body": "DESCRIBE HISTORY $0" },
  "shw": { "prefix": "shw", "description": "SHOW TABLES", "body": "SHOW TABLES$0" },
  "opt": { "prefix": "opt", "description": "OPTIMIZE (compact a Delta table)", "body": "OPTIMIZE $0" },
  "vac": { "prefix": "vac", "description": "VACUUM (clean old Delta files)", "body": "VACUUM $0" },

  "cte": { "prefix": "cte", "description": "WITH cte AS (...)", "body": ["WITH $1 AS (", "\t$2", ")", "SELECT *", "FROM $0"] },
  "rn": { "prefix": "rn", "description": "ROW_NUMBER() OVER (...)", "body": "ROW_NUMBER() OVER (PARTITION BY $1 ORDER BY $2) AS rn$0" },
  "rk": { "prefix": "rk", "description": "RANK() OVER (...)", "body": "RANK() OVER (PARTITION BY $1 ORDER BY $2) AS rnk$0" },
  "lg": { "prefix": "lg", "description": "LAG() OVER (...)", "body": "LAG($1) OVER (PARTITION BY $2 ORDER BY $3)$0" },
  "ld": { "prefix": "ld", "description": "LEAD() OVER (...)", "body": "LEAD($1) OVER (PARTITION BY $2 ORDER BY $3)$0" },
  "rt": { "prefix": "rt", "description": "Running total: SUM() OVER (...)", "body": "SUM($1) OVER (PARTITION BY $2 ORDER BY $3 ROWS UNBOUNDED PRECEDING) AS running_total$0" },
  "cw": { "prefix": "cw", "description": "CASE WHEN ... END", "body": ["CASE", "\tWHEN $1 THEN $2", "\tELSE $3", "END$0"] },

  "coa": { "prefix": "coa", "description": "COALESCE(..., ...)", "body": "COALESCE($1, $2)$0" },
  "cst": { "prefix": "cst", "description": "CAST(... AS ...)", "body": "CAST($1 AS $2)$0" },
  "gd": { "prefix": "gd", "description": "current_date()", "body": "current_date()$0" },
  "gts": { "prefix": "gts", "description": "current_timestamp()", "body": "current_timestamp()$0" },
  "dta": { "prefix": "dta", "description": "date_add(date, days)", "body": "date_add($1, $2)$0" },
  "dtd": { "prefix": "dtd", "description": "datediff(end, start)", "body": "datediff($1, $2)$0" },
  "dfmt": { "prefix": "dfmt", "description": "date_format(..., 'yyyy-MM-dd')", "body": "date_format($1, 'yyyy-MM-dd')$0" },
  "tdt": { "prefix": "tdt", "description": "to_date(..., 'yyyy-MM-dd')", "body": "to_date($1, 'yyyy-MM-dd')$0" },
  "cws": { "prefix": "cws", "description": "concat_ws(', ', ...)", "body": "concat_ws(', ', $1)$0" },
  "clst": { "prefix": "clst", "description": "collect_list(...)", "body": "collect_list($1)$0" },

  "sqlc": { "prefix": "sqlc", "description": "%%sql cell", "body": ["%%sql", "$0"] },
  "pysc": { "prefix": "pysc", "description": "%%pyspark cell", "body": ["%%pyspark", "$0"] },

  "sps": { "prefix": "sps", "description": "spark.sql(\"\"\"...\"\"\")", "body": ["spark.sql(\"\"\"", "$1", "\"\"\")$0"] },
  "dfs": { "prefix": "dfs", "description": "df = spark.sql(...) and display it", "body": ["df = spark.sql(\"\"\"", "SELECT *", "FROM $1", "\"\"\")", "display(df)$0"] },
  "dsp": { "prefix": "dsp", "description": "display(...)", "body": "display($1)$0" },
  "rtb": { "prefix": "rtb", "description": "spark.read.table(\"...\")", "body": "spark.read.table(\"$1\")$0" },
  "dfr": { "prefix": "dfr", "description": "df = spark.read.table(\"...\")", "body": "df = spark.read.table(\"$1\")$0" },
  "rcsv": { "prefix": "rcsv", "description": "Read a CSV from Files/", "body": "spark.read.option(\"header\", True).csv(\"Files/$1\")$0" },
  "rpq": { "prefix": "rpq", "description": "Read Parquet from Files/", "body": "spark.read.parquet(\"Files/$1\")$0" },
  "rjs": { "prefix": "rjs", "description": "Read JSON from Files/", "body": "spark.read.json(\"Files/$1\")$0" },
  "wov": { "prefix": "wov", "description": "Write: overwrite a Delta table", "body": ".write.mode(\"overwrite\").format(\"delta\").saveAsTable(\"$1\")$0" },
  "wap": { "prefix": "wap", "description": "Write: append to a Delta table", "body": ".write.mode(\"append\").format(\"delta\").saveAsTable(\"$1\")$0" },
  "impf": { "prefix": "impf", "description": "Import functions as F and Window", "body": ["from pyspark.sql import functions as F", "from pyspark.sql.window import Window", "$0"] },
  "flt": { "prefix": "flt", "description": ".filter(F.col(...) == ...)", "body": ".filter(F.col(\"$1\") == $2)$0" },
  "gby": { "prefix": "gby", "description": ".groupBy(...).agg(count)", "body": ".groupBy(\"$1\").agg(F.count(\"*\").alias(\"cnt\"))$0" },
  "wcol": { "prefix": "wcol", "description": ".withColumn(...)", "body": ".withColumn(\"$1\", $2)$0" },
  "sel": { "prefix": "sel", "description": ".select(...)", "body": ".select(\"$1\")$0" },
  "srt": { "prefix": "srt", "description": ".orderBy(... desc)", "body": ".orderBy(F.col(\"$1\").desc())$0" },
  "jdf": { "prefix": "jdf", "description": ".join(other, on=..., how=\"left\")", "body": ".join($1, on=\"$2\", how=\"left\")$0" },
  "shwt": { "prefix": "shwt", "description": ".show(20, truncate=False)", "body": ".show(20, truncate=False)$0" },
  "pdf": { "prefix": "pdf", "description": ".toPandas()", "body": ".toPandas()$0" },
  "nfs": { "prefix": "nfs", "description": "notebookutils.fs.ls(\"Files/...\")", "body": "notebookutils.fs.ls(\"Files/$1\")$0" },
  "nrun": { "prefix": "nrun", "description": "notebookutils.notebook.run(...)", "body": "notebookutils.notebook.run(\"$1\", 600)$0" }
}
